{
  "name": "@campusos/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "dev:db": "tsx --env-file-if-exists=../.env scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security --project security-db",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "db:bootstrap": "tsx --env-file-if-exists=../.env tools/db/cli.ts bootstrap",
    "db:migrate": "tsx --env-file-if-exists=../.env tools/db/cli.ts migrate",
    "test:security:db": "vitest run --project security-db"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}

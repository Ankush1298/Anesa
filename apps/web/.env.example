# Public (browser-visible) settings only. Everything prefixed VITE_ is embedded in the bundle: never put a
# secret here. Optional; the default is shown.
VITE_API_BASE_PATH=/api
# Dev server only (not embedded): where the Vite proxy forwards /api. Default http://127.0.0.1:4000
# DEV_API_ORIGIN=http://127.0.0.1:4000

{
  "name": "@campusos/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Anesa web client for Smart Campus OS (private, authenticated, same-origin SPA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:bundle": "tsx scripts/check-bundle.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-axe": "^0.1.0"
  }
}

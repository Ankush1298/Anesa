# Copy to .env (never commit .env). infrastructure/scripts/setup-dev.sh does this and
# generates a random database password for you. Values below are placeholders only.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# PostgreSQL (dev: docker compose or `pnpm dev:db`). Replace change_me with a random value.
DATABASE_URL=postgresql://campusos:change_me@127.0.0.1:54329/campusos_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Only set to true when running behind a trusted reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# docker compose (infrastructure/docker/docker-compose.yml) reads this; keep it equal to the password in DATABASE_URL.
POSTGRES_PASSWORD=change_me

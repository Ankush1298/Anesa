# Copy to .env (never commit .env). infrastructure/scripts/setup-dev.sh does this and
# generates a random database password for you. Values below are placeholders only.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# PostgreSQL (dev: docker compose or `pnpm dev:db`). Three DIFFERENT identities, three passwords.
#  - DATABASE_URL            app_runtime   : the ONLY credential the running application uses
#  - MIGRATION_DATABASE_URL  app_migrator  : schema owner, used by `pnpm db:migrate` only (never loaded by the app)
#  - DATABASE_ADMIN_URL      superuser     : used by `pnpm db:bootstrap` / dev:db / tests only (dev, CI; never in production app config)
DATABASE_URL=postgresql://app_runtime:change_me_runtime@127.0.0.1:54329/campusos_dev
MIGRATION_DATABASE_URL=postgresql://app_migrator:change_me_migrator@127.0.0.1:54329/campusos_dev
DATABASE_ADMIN_URL=postgresql://campusos_admin:change_me_admin@127.0.0.1:54329/campusos_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Only set to true when running behind a trusted reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# docker compose (infrastructure/docker/docker-compose.yml) reads this; keep it equal to the password in DATABASE_URL.
POSTGRES_PASSWORD=change_me_admin
